<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="2dp">
    <TextView android:id="@+id/row_goal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="14sp" android:textStyle="bold" android:textColor="#203C32" android:maxLines="2" android:ellipsize="end" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/row_minimum" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/row_min_button" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="@string/minimum_action" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:textColor="#254D3D" android:background="@drawable/widget_button" android:layout_marginEnd="1dp"/>
    <TextView android:id="@+id/row_full_button" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="@string/full_action" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:textColor="#254D3D" android:background="@drawable/widget_button" android:layout_marginEnd="1dp"/>
    <TextView android:id="@+id/row_extra_button" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="@string/challenge_action" android:textSize="12sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:textColor="#254D3D" android:background="@drawable/widget_button"/>
</LinearLayout>
