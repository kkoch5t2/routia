<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/widget_root" android:forceDarkAllowed="false" tools:targetApi="29" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg">
    <!-- A separate ImageView accepts the cropped RemoteViews bitmap portrait. -->
    <LinearLayout tools:ignore="UseCompoundDrawables" android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical"><ImageView android:id="@+id/widget_mascot" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no"/><TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="24dp" android:text="@string/record_widget_title" android:textSize="14sp" android:textStyle="bold" android:textColor="#203C32" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical"/></LinearLayout>
    <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:scrollbars="vertical" android:fadeScrollbars="false" android:contentDescription="@string/widget_scroll_description"/>
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/widget_empty" android:textSize="12sp" android:textColor="#50685A" android:gravity="center_vertical"/>
    </FrameLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
